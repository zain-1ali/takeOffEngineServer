PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/takeoff-engine
# Exact browser origin(s), comma-separated, no trailing slash.
# Production example: https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# Optional alias: FRONTEND_ORIGINS=https://app.vercel.app,http://localhost:5173
# Railway Bucket (S3-compatible). When set, PDFs/PNGs/thumbs persist in the bucket
# and /uploads is proxied from there. Leave empty to use local backend/uploads.
RAILWAY_BUCKET=
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=
RAILWAY_ENDPOINT=https://t3.storageapi.dev
# Optional. Default auto. Set RAILWAY_S3_FORCE_PATH_STYLE=true if PutObject fails.
# RAILWAY_REGION=auto

JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Google Sign-In (OAuth Web client ID — same value as VITE_GOOGLE_CLIENT_ID on the frontend)
GOOGLE_CLIENT_ID=
# SMTP for verification + password-reset emails (Gmail: use an App Password, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgileQS <you@gmail.com>
# OpenRouter — rate-databank import + AI room extraction (Claude Sonnet 5)
OPENROUTER_API_KEY=
# Optional override (default anthropic/claude-sonnet-5)
OPENROUTER_MODEL=
